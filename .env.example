# PostgreSQL
POSTGRES_USER=gcb_user
POSTGRES_PASSWORD=gcb_password
POSTGRES_DB=gcb_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
SECRET_KEY=change_me_in_production_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Public MileON lead/contact target used by the calculator CTA
NEXT_PUBLIC_MILEON_CONTACT_URL=https://wa.me/995577115757

# Official Bank of Russia exchange rates (XML, no API key required)
EXCHANGE_API_URL=https://www.cbr.ru/scripts/XML_daily.asp
EXCHANGE_CACHE_TTL_SECONDS=3600

# myauto.ge API
MYAUTO_API_URL=https://api2.myauto.ge/ka

# Free NHTSA vPIC VIN decoder (no API key required)
NHTSA_VPIC_API_URL=https://vpic.nhtsa.dot.gov/api
NHTSA_VPIC_TIMEOUT_SECONDS=10
NHTSA_VPIC_CACHE_TTL_SECONDS=86400

# Drom Search API (optional automatic Russia-market comparison)
# IMPORTANT: Drom rules require authorized access for automated extraction.
# Keep this false until Drom has confirmed API/database access for this use case.
DROM_API_URL=https://api.drom.ru/v1.2
DROM_API_ACCESS_CONFIRMED=false

# Optional authorized query parameters supplied by Drom, if your access contract requires them.
# Do not derive/reuse private app secrets. Example shape only: {"sign":"issued-by-drom"}
DROM_API_AUTH_QUERY_JSON={}

# Mapping from MileON make/model names to Drom numeric firmId/modelId values supplied/confirmed for your integration.
# Supported shapes:
# {"Tesla":{"firmId":123,"models":{"Model Y":456}}}
# or {"Tesla|Model Y":{"firmId":123,"modelId":456}}
# Leave empty until real IDs are confirmed; the example numbers above are placeholders only.
DROM_VEHICLE_ID_MAP_JSON={}
DROM_MARKET_TIMEOUT_SECONDS=10
DROM_MARKET_PAGES=3
DROM_MARKET_MIN_SAMPLES=5
DROM_MARKET_TRIM_FRACTION=0.10
DROM_MARKET_MILEAGE_WINDOW_PERCENT=0.35
DROM_MARKET_MILEAGE_WINDOW_MIN_KM=30000
DROM_MARKET_CACHE_TTL_SECONDS=3600
