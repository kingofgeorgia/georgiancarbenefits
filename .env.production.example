# Public domain handled by Caddy
APP_DOMAIN=example.com
APP_ENV=production

# PostgreSQL
POSTGRES_USER=mileon
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=mileon
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend security
SECRET_KEY=replace_with_at_least_32_random_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public frontend origin used by CORS
FRONTEND_ORIGIN=https://example.com

# Public MileON lead/contact target used by the calculator CTA
NEXT_PUBLIC_MILEON_CONTACT_URL=https://wa.me/995577115757

# Exchange rates
EXCHANGE_API_URL=https://www.cbr.ru/scripts/XML_daily.asp
EXCHANGE_CACHE_TTL_SECONDS=3600

# myauto.ge API
MYAUTO_API_URL=https://api2.myauto.ge/ka

# Free NHTSA vPIC VIN decoder
NHTSA_VPIC_API_URL=https://vpic.nhtsa.dot.gov/api
NHTSA_VPIC_TIMEOUT_SECONDS=10
NHTSA_VPIC_CACHE_TTL_SECONDS=86400

# Official Auto.ru Business Appraisal.API (optional automatic Russia-market comparison)
# Store the real token only in the deployment environment / secret store.
AUTO_RU_BUSINESS_API_URL=https://appraisal.api.cm.expert/v1
AUTO_RU_BUSINESS_TOKEN=
AUTO_RU_BUSINESS_SOURCES=auto_ru
AUTO_RU_BUSINESS_LIQUIDITY_REGION_ID=1960671
AUTO_RU_BUSINESS_TIMEOUT_SECONDS=10
AUTO_RU_MARKET_SIMILAR_THRESHOLD=10
AUTO_RU_MARKET_CACHE_TTL_SECONDS=3600
