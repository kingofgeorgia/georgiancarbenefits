# Public domain handled by Caddy
APP_DOMAIN=example.com
APP_ENV=production

# PostgreSQL
POSTGRES_USER=mileon
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=mileon
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend security
SECRET_KEY=replace_with_at_least_32_random_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public frontend origin used by CORS
FRONTEND_ORIGIN=https://example.com

# Public MileON lead/contact target used by the calculator CTA
NEXT_PUBLIC_MILEON_CONTACT_URL=https://wa.me/995577115757

# Exchange rates
EXCHANGE_API_URL=https://www.cbr.ru/scripts/XML_daily.asp
EXCHANGE_CACHE_TTL_SECONDS=3600

# myauto.ge API
MYAUTO_API_URL=https://api2.myauto.ge/ka

# Free NHTSA vPIC VIN decoder
NHTSA_VPIC_API_URL=https://vpic.nhtsa.dot.gov/api
NHTSA_VPIC_TIMEOUT_SECONDS=10
NHTSA_VPIC_CACHE_TTL_SECONDS=86400

# Drom Search API (optional automatic Russia-market comparison)
# Enable only after Drom has confirmed authorized API/database access for this use case.
DROM_API_URL=https://api.drom.ru/v1.2
DROM_API_ACCESS_CONFIRMED=false
DROM_API_AUTH_QUERY_JSON={}
DROM_VEHICLE_ID_MAP_JSON={}
DROM_MARKET_TIMEOUT_SECONDS=10
DROM_MARKET_PAGES=3
DROM_MARKET_MIN_SAMPLES=5
DROM_MARKET_TRIM_FRACTION=0.10
DROM_MARKET_MILEAGE_WINDOW_PERCENT=0.35
DROM_MARKET_MILEAGE_WINDOW_MIN_KM=30000
DROM_MARKET_CACHE_TTL_SECONDS=3600
